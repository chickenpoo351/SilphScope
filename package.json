{
  "name": "silphscope",
  "version": "1.4.18",
  "description": "A firered/leafgreen ROM asset extractor for use in web applications",
  "main": "main.js",
  "exports": {
    ".": {
      "import": "./main.js",
      "types": "./silphscope.d.ts"
    }
  },
  "files": [
    "main.js",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "graphics-maps/",
    "mon-data/",
    "rom-maps/",
    "item-data/",
    "trainer-data",
    "rom-configs/",
    "move-data/",
    "!src/icon-data-parser.js",
    "!src/mon-data-parser.js",
    "!src/trainer-data-parser.js",
    "!src/move-data-parser.js",
    "!src/rom-map-parser.js",
    "!rom-maps/",
    "!graphics-maps/",
    "ball-data/",
    "!src/object-event-data-parser.js",
    "silphscope.d.ts"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "gba",
    "gameboy-advance",
    "pokemon",
    "firered",
    "pokemon-firered",
    "leafgreen",
    "pokemon-leafgreen",
    "rom",
    "asset",
    "asset-extractor",
    "sprite",
    "sprite-extractor",
    "extractor",
    "gen3",
    "generation-3"
  ],
  "author": "chickenPoo",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chickenpoo351/SilphScope.git"
  }
}
